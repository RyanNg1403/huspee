{
  "name": "huspee",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "build": "pnpm -r --filter @huspee/sdk --filter @huspee/api run build",
    "dev": "pnpm --filter @huspee/api run dev",
    "db:migrate": "pnpm --filter @huspee/api run db:migrate",
    "db:reset": "pnpm --filter @huspee/api run db:reset",
    "db:seed": "pnpm --filter @huspee/api run db:seed",
    "db:catalog:sync": "pnpm --filter @huspee/api run db:catalog:sync",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm build && pnpm --filter @huspee/tests run test",
    "test:upstream": "pnpm --filter @huspee/tests run test:upstream",
    "test:extensions": "pnpm --filter @huspee/tests run test:extensions",
    "test:e2e": "pnpm --filter @huspee/tests run test:e2e",
    "dev:web": "pnpm --filter @huspee/web dev",
    "build:web": "pnpm --filter @huspee/sdk build && pnpm --filter @huspee/web build && pnpm --filter @huspee/seller-web build",
    "demo:reset": "pnpm --filter @huspee/api exec prisma migrate reset --force",
    "smoke:ui": "node tests/ui/smoke.mjs",
    "smoke:mobile": "node tests/ui/mobile.mjs",
    "smoke:product-context": "node tests/ui/product-context.mjs",
    "smoke:chat-continuity": "node tests/ui/chat-continuity.mjs",
    "smoke:microphone-meter": "node tests/ui/microphone-meter.mjs",
    "smoke:chat-layout": "node tests/ui/chat-layout.mjs",
    "eval:assistant": "pnpm --filter @huspee/api run eval:assistant",
    "dev:seller-web": "pnpm --filter @huspee/seller-web dev",
    "build:seller-web": "pnpm --filter @huspee/sdk build && pnpm --filter @huspee/seller-web build",
    "smoke:dual-session": "node tests/ui/dual-session.mjs",
    "smoke:seller-commerce": "node tests/ui/seller-commerce.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild"
    ]
  },
  "devDependencies": {
    "playwright-core": "1.64.1"
  }
}
