# Browsers always use this app origin.
# Server-only API address; never sent to the phone.
API_INTERNAL_URL=http://127.0.0.1:3000
API_PUBLIC_URL=http://localhost:3000
WEB_APP_URL=http://localhost:3001
SELLER_APP_URL=http://localhost:3002
# Optional single-origin mode: build seller with SELLER_BASE_PATH=/seller, then set
# SELLER_APP_URL=https://your-public-host/seller and uncomment the internal upstream.
# SELLER_INTERNAL_URL=http://127.0.0.1:3002
