  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.14",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.1",
